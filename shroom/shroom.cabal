cabal-version: 3.0
name: shroom
version: 0.1.0.0
synopsis: Type-safe structured LLM prompting for Haskell
description:
  shroom is a small library for building typed LLM conversations.
  Write a monadic program using @context@ and @prompt@, choose a backend
  (Anthropic Claude or a local Ollama model), and get back a typed Haskell
  value — or a descriptive error.
  .
  If the model hallucinates, at least it will be a well-typed hallucination.

license: BSD-3-Clause
license-file: LICENSE
author: Manuel Bärenz
maintainer: programming@manuelbaerenz.de
-- copyright:
build-type: Simple
extra-doc-files: CHANGELOG.md
-- extra-source-files:
tested-with:
  ghc ==9.10
  ghc ==9.12

flag anthropic
  description:
    Build shroom-test-integration-claude, which calls the real Anthropic
    API and needs ANTHROPIC_API_KEY.

  default: True
  manual: True

flag ollama
  description:
    Build shroom-test-integration-ollama, which needs a reachable Ollama
    server.

  default: True
  manual: True

flag web
  description:
    Build shroom-test-web-tools, which makes real calls to DuckDuckGo and
    Wikipedia.

  default: True
  manual: True

common opts
  ghc-options:
    -Wall
    -haddock

  build-depends:
    aeson ^>=2.2,
    base >=4.20 && <4.22,
    bytestring ^>=0.12,
    claude ^>=1.4.0,
    containers ^>=0.6,
    directory ^>=1.3,
    filepath ^>=1.5,
    http-client ^>=0.7,
    modern-uri ^>=0.3,
    mtl ^>=2.3,
    ollama-haskell ^>=0.2,
    openapi3 ^>=3.2,
    req ^>=3.13,
    sop-core ^>=0.5,
    tagsoup ^>=0.14,
    template-haskell >=2.22 && <2.25,
    text ^>=2.1.4,
    time ^>=1.14,
    transformers ^>=0.6,
    universe-base ^>=1.1,
    unliftio ^>=0.2,
    vector ^>=0.13,
    witherable ^>=0.5,

  default-extensions:
    DefaultSignatures
    DerivingVia
    OverloadedLists
    OverloadedRecordDot
    OverloadedStrings
    TypeFamilies

library
  import: opts
  exposed-modules:
    Control.Monad.Prompt
    Control.Monad.Prompt.Anthropic
    Control.Monad.Prompt.FileMock
    Control.Monad.Prompt.Ollama
    Control.Monad.Prompt.TH
    Control.Monad.Prompt.Tool
    Control.Monad.Prompt.Tool.Web
    Data.Shroom.Class
    Data.Shroom.Class.Promptable

  other-modules:
    Control.Monad.Prompt.Core
    Control.Monad.Prompt.Schema

  hs-source-dirs: src
  default-language: GHC2024

library test-utils
  import: opts
  hs-source-dirs: test-utils
  default-language: GHC2024
  build-depends:
    shroom

  exposed-modules:
    CelebrityTypes
    ConferenceTypes
    TestUtils
    Types

common test-opts
  build-depends:
    shroom,
    tasty ^>=1.4,
    tasty-hunit ^>=0.10,
    test-utils,

test-suite shroom-test
  import: opts, test-opts
  default-language: GHC2024
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs

test-suite shroom-test-integration-claude
  import: opts, test-opts
  default-language: GHC2024
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Integration/Claude.hs
  other-modules:
    WebToolReport

  if !flag(anthropic)
    buildable: False

test-suite shroom-test-integration-ollama
  import: opts, test-opts
  default-language: GHC2024
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Integration/Ollama.hs

  if !flag(ollama)
    buildable: False

test-suite shroom-test-conference
  import: opts, test-opts
  default-language: GHC2024
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: ConferenceScenario.hs

test-suite shroom-test-celebrity
  import: opts, test-opts
  default-language: GHC2024
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: CelebrityScenario.hs

test-suite shroom-test-web-tools
  import: opts, test-opts
  default-language: GHC2024
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: WebToolsScenario.hs
  build-depends:
    text

  if !flag(web)
    buildable: False

executable shroom-dev
  import: opts, test-opts
  default-language: GHC2024
  hs-source-dirs:
    app
    test

  main-is: Main.hs

executable shroom-conference-claude
  import: opts, test-opts
  default-language: GHC2024
  hs-source-dirs:
    app
    test

  main-is: Claude.hs
