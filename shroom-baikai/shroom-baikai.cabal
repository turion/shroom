cabal-version: 3.0
name: shroom-baikai
version: 0.1.0.0
synopsis: The baikai transport adapter for shroom
description:
  Implements shroom's 'Control.Monad.Prompt.Backend.Backend' interface by
  interpreting @baikai-effectful@'s @Baikai@ effect, so a shroom program
  runs unchanged against Claude (@baikai-claude@) or any OpenAI-compatible
  host, including a local Ollama, (@baikai-openai@).

license: BSD-3-Clause
license-file: LICENSE
author: Manuel Bärenz
maintainer: programming@manuelbaerenz.de
-- copyright:
build-type: Simple
-- extra-source-files:
tested-with:
  ghc ==9.12

flag anthropic
  description:
    Build shroom-test-integration-claude, which calls the real Anthropic
    API and needs ANTHROPIC_API_KEY.

  default: True
  manual: True

flag ollama
  description:
    Build shroom-test-integration-ollama, which needs a reachable Ollama
    server.

  default: True
  manual: True

flag online
  description:
    Master switch for the test suites that need network or an external
    service. Off under nix, where the sandbox has no network.

  default: True
  manual: True

common opts
  ghc-options:
    -Wall
    -haddock

  build-depends:
    aeson ^>=2.2,
    baikai >=0.7.0 && <0.8,
    baikai-claude >=0.7.0 && <0.8,
    baikai-effectful >=0.4.0 && <0.5,
    baikai-openai >=0.7.0 && <0.8,
    base >=4.20 && <4.22,
    effectful ^>=2.7,
    shroom,
    text >=2.1.3 && <2.2,
    vector ^>=0.13,

  default-extensions:
    DefaultSignatures
    DerivingVia
    OverloadedLists
    OverloadedRecordDot
    OverloadedStrings
    TypeFamilies

library
  import: opts
  exposed-modules:
    Control.Monad.Prompt.Baikai

  hs-source-dirs: src
  default-language: GHC2024

common test-opts
  build-depends:
    openapi3 ^>=3.2,
    shroom,
    shroom:test-utils,
    shroom-baikai,
    tasty >=1.4 && <1.6,
    tasty-hunit ^>=0.10,

test-suite shroom-test-integration-claude
  import: opts, test-opts
  default-language: GHC2024
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Integration/Claude.hs
  other-modules:
    Integration.Cases

  if !(flag(anthropic) && flag(online))
    buildable: False

test-suite shroom-test-integration-ollama
  import: opts, test-opts
  default-language: GHC2024
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Integration/Ollama.hs
  other-modules:
    Integration.Cases
    ScalarTypes

  if !(flag(ollama) && flag(online))
    buildable: False

executable shroom-conference-claude
  import: opts, test-opts
  default-language: GHC2024
  hs-source-dirs: app
  main-is: Claude.hs
  build-depends:
    time ^>=1.14
